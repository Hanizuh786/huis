RewriteEngine On
RewriteRule ^wiebenik/?$ /wie-ben-ik.html [R=301,L]
RewriteRule ^kernkwaliteitenhilda/?$ /juridisch-advies.html [R=301,L]
RewriteRule ^ikbenhieromdat\.html$ /persoonlijke-juridische-vraag.html [R=301,L]
RewriteRule ^mijnzakelijkeprobleem\.html$ /zakelijke-juridische-vraag.html [R=301,L]
RewriteRule ^certificeringen-en-awards\.html$ /certificeringen.html [R=301,L]
RewriteRule ^privacy-policy\.html$ /privacy.html [R=301,L]
RewriteRule ^betaling/?$ /betalen.html [R=301,L]
RewriteRule ^contact/?$ /contact.html [R=301,L]
RewriteRule ^contact/via-linkedin\.html$ /contact.html [R=301,L]
RewriteRule ^contact/via-facebook\.html$ /contact.html [R=301,L]
RewriteRule ^contact/via-phone-you-can-reach-is\.html$ /contact.html [R=301,L]
RewriteRule ^contact/via-e-mail\.html$ /contact.html [R=301,L]
RewriteRule ^contact/our-office-in-the-netherlan\.html$ /contact.html#kantoor [R=301,L]
RewriteRule ^zoeken/?$ /zoeken.html [R=301,L]

# --- Basisbeveiliging ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
