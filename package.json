{
  "name": "huisjurist-clone",
  "version": "1.0.0",
  "description": "Static clone of huisjurist.nl — Bootstrap 5 + SCSS + vanilla JS",
  "private": true,
  "scripts": {
    "build": "sass --load-path=node_modules --silence-deprecation=import scss/main.scss assets/css/main.css --style=compressed --no-source-map && node scripts/copy-vendor.js",
    "watch": "sass --load-path=node_modules --silence-deprecation=import scss/main.scss assets/css/main.css --style=expanded --watch"
  },
  "devDependencies": {
    "bootstrap": "^5.3.3",
    "sass": "^1.77.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  }
}
